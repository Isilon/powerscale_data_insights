    {
      "id": 2,
      "type": "stat",
      "title": "Total Client Ops/s",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
