      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"operation_rate\") FROM \"node.summary.client\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND \"protocol\" =~ /^$protocol$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
