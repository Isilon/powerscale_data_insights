    {
      "id": 2,
      "type": "stat",
      "title": "Total Drive IOPS",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"xfers_in\") + sum(\"xfers_out\") FROM \"node.summary.drive\" WHERE \"cluster\" =~ /^$cluster$/ AND \"type\" =~ /^$type$/ AND \"drive_id\" =~ /^$drive_id$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "orientation": "auto",
        "graphMode": "area",
        "textMode": "auto",
        "wideLayout": true
