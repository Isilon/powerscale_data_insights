    {
      "id": 2,
      "type": "stat",
      "title": "Total Drive IOPS",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(isilon_stat_node_summary_drive_xfers_in{cluster=~\"$cluster\",type=~\"$type\",drive_id=~\"$drive_id\",type!=\"UNKNOWN\"}) + sum(isilon_stat_node_summary_drive_xfers_out{cluster=~\"$cluster\",type=~\"$type\",drive_id=~\"$drive_id\",type!=\"UNKNOWN\"})",
          "legendFormat": "",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "orientation": "auto",
        "graphMode": "area",
        "textMode": "auto",
        "wideLayout": true
