    {
      "id": 6,
      "type": "table",
      "title": "Node Disk Health Summary",
      "description": "Current disk metrics per node. Sorted by access latency (worst first). Color thresholds highlight problem nodes.",
      "datasource": {
        "type": "influxdb",
        "uid": "DS_INFLUXDB"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "rawQuery": true,
          "query": "SELECT last(\"value\") * 1000 AS \"Access Latency (ms)\" FROM \"node.disk.access.latency.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND $timeFilter GROUP BY \"node\"",
          "resultFormat": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "rawQuery": true,
          "query": "SELECT last(\"value\") * 1000 AS \"IOSched Latency (ms)\" FROM \"node.disk.iosched.latency.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND $timeFilter GROUP BY \"node\"",
          "resultFormat": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "rawQuery": true,
          "query": "SELECT last(\"value\") AS \"Queue Depth\" FROM \"node.disk.iosched.queue.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND $timeFilter GROUP BY \"node\"",
          "resultFormat": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "rawQuery": true,
          "query": "SELECT last(\"value\") / 10 AS \"Busy %\" FROM \"node.disk.busy.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND $timeFilter GROUP BY \"node\"",
          "resultFormat": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "rawQuery": true,
          "query": "SELECT last(\"value\") AS \"Slow Accesses/s\" FROM \"node.disk.access.slow.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND \"node\" =~ /^$node$/ AND $timeFilter GROUP BY \"node\"",
          "resultFormat": "table"
        }
      ],
