            {
              "refId": "D",
              "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
              "rawQuery": true,
              "query": "SELECT mean(\"value\") / 1000 FROM \"cluster.cpu.idle.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
