              "query": "SELECT mean(\"value\") / 1000 FROM \"cluster.cpu.user.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
              "resultFormat": "time_series",
