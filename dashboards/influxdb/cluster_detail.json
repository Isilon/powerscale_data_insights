      "collapsed": true,
      "panels": [
        {
          "id": 15,
          "type": "timeseries",
          "title": "Cluster CPU Breakdown",
          "description": "Stacked breakdown of cluster CPU usage by category",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
              "rawQuery": true,
              "query": "SELECT mean(\"value\") / 1000 FROM \"cluster.cpu.intr.avg\" WHERE \"cluster\" =~ /^$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
              "resultFormat": "time_series",
              "alias": "Interrupt"
            },
            {
              "refId": "B",
              "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
