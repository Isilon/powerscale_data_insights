    {
      "id": 2,
      "type": "stat",
      "title": "Total Nodes",
      "datasource": {
        "type": "influxdb",
        "uid": "DS_INFLUXDB"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "resultFormat": "time_series",
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"cluster.node.count.all\" WHERE \"cluster\" =~ /^$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "rgba(50, 172, 45, 0.97)",
                "value": null
              },
              {
                "color": "rgba(237, 129, 40, 0.89)",
                "value": 1.0
              },
              {
                "color": "rgba(245, 54, 54, 0.9)",
                "value": 2.0
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
