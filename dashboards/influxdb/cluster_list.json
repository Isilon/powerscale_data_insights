    },
    {
      "id": 9,
      "type": "stat",
      "title": "NFS Latency",
      "description": "Average NFS operation latency",
      "gridPos": { "h": 4, "w": 2, "x": 16, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
