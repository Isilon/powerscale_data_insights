    {
      "id": 10,
      "type": "stat",
      "title": "SMB2 Throughput",
      "description": "Combined SMB2 in/out throughput",
      "gridPos": { "h": 4, "w": 2, "x": 18, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
