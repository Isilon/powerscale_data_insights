    {
      "id": 11,
      "type": "timeseries",
      "title": "Cluster $protocol Operations and CPU for $cluster",
      "datasource": {
        "type": "influxdb",
        "uid": "DS_INFLUXDB"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "resultFormat": "time_series",
          "rawQuery": true,
          "query": "SELECT 1.0 - mean(\"value\") / 1000.0 FROM \"cluster.cpu.idle.avg\" WHERE \"cluster\" =~ /$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
          "alias": "CPU"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "resultFormat": "time_series",
          "rawQuery": true,
          "query": "SELECT mean(\"op_rate\") FROM \"cluster.protostats.$protocol.total\" WHERE \"cluster\" =~ /$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)",
          "alias": "$2 ops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 1,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "barAlignment": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisLabel": "CPU Busy"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "ops"
