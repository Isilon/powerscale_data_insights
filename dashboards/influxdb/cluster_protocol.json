      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "DS_INFLUXDB"
          },
          "resultFormat": "time_series",
          "rawQuery": true,
          "query": "SELECT max(\"value\") FROM \"cluster.node.count.all\" WHERE \"cluster\" =~ /^$cluster$/ AND $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
