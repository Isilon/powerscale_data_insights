  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "query": "SHOW TAG VALUES WITH KEY = \"cluster\"",
        "definition": "SHOW TAG VALUES WITH KEY = \"cluster\"",
        "regex": "",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "protocol",
        "type": "custom",
        "query": "nfs,nfs3,nfs4,smb1,smb2,hdfs,ftp,siq,lsass_in,lsass_out,papi",
        "current": {
          "selected": true,
          "text": "smb2",
          "value": "smb2"
        },
        "options": [
          { "selected": false, "text": "nfs", "value": "nfs" },
          { "selected": false, "text": "nfs3", "value": "nfs3" },
          { "selected": false, "text": "nfs4", "value": "nfs4" },
          { "selected": false, "text": "smb1", "value": "smb1" },
          { "selected": true, "text": "smb2", "value": "smb2" },
          { "selected": false, "text": "hdfs", "value": "hdfs" },
          { "selected": false, "text": "ftp", "value": "ftp" },
          { "selected": false, "text": "siq", "value": "siq" },
          { "selected": false, "text": "lsass_in", "value": "lsass_in" },
          { "selected": false, "text": "lsass_out", "value": "lsass_out" },
          { "selected": false, "text": "papi", "value": "papi" }
