  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": "label_values(isilon_stat_cluster_health, cluster)",
        "definition": "label_values(isilon_stat_cluster_health, cluster)",
        "sort": 3,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
