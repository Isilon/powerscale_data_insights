        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 200,
      "type": "row",
      "title": "Cluster: $cluster",
      "collapsed": false,
      "repeat": "cluster",
      "repeatDirection": "h",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
