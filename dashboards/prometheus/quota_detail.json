      "options": {
        "mode": "markdown",
        "content": "## PowerScale - Quota Detail\n\nUsage, limits, and inode history for the selected quota path. If several quota\ndomains share a path, use quota type and snapshot inclusion to disambiguate\nthem. Missing lines indicate an unset threshold or a value that OneFS reports\nas not ready; they are never converted to zero.\n",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Usage and Thresholds",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "isilon_quota_usage_bytes{cluster=~\"$cluster\",path=~\"$path\",quota_type=~\"$quota_type\",include_snapshots=~\"$include_snapshots\"}",
          "legendFormat": "Usage",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "isilon_quota_advisory_bytes{cluster=~\"$cluster\",path=~\"$path\",quota_type=~\"$quota_type\",include_snapshots=~\"$include_snapshots\"}",
          "legendFormat": "Advisory",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "isilon_quota_soft_bytes{cluster=~\"$cluster\",path=~\"$path\",quota_type=~\"$quota_type\",include_snapshots=~\"$include_snapshots\"}",
          "legendFormat": "Soft",
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "isilon_quota_hard_bytes{cluster=~\"$cluster\",path=~\"$path\",quota_type=~\"$quota_type\",include_snapshots=~\"$include_snapshots\"}",
          "legendFormat": "Hard",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "barAlignment": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "mean",
            "lastNotNull"
          ],
          "width": 500
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
